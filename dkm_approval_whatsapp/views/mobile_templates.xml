<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="mobile_layout" name="DKM Approval: mobile layout">&lt;!DOCTYPE html&gt;
        <html lang="id">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
                <meta name="robots" content="noindex, nofollow"/>
                <meta name="referrer" content="no-referrer"/>
                <title t-out="page_title or 'Persetujuan Pengeluaran'"/>
                <style>
                    :root {
                        --bg: #f3f5f4; --card: #ffffff; --text: #17201d; --muted: #5d6b66;
                        --line: #e2e8e5; --brand: #0f6b5c; --brand-ink: #ffffff;
                        --ok: #157347; --ok-bg: #e5f4ec; --bad: #b42318; --bad-bg: #fdecea;
                        --warn-bg: #fff6e0; --warn: #8a5a00;
                    }
                    @media (prefers-color-scheme: dark) {
                        :root {
                            --bg: #0f1513; --card: #18211e; --text: #e8eeeb; --muted: #9db0a8;
                            --line: #2a3632; --brand: #2fa58d; --brand-ink: #06110e;
                            --ok: #4cc38a; --ok-bg: #12291f; --bad: #f97066; --bad-bg: #2e1513;
                            --warn-bg: #2b2210; --warn: #f5c060;
                        }
                    }
                    * { box-sizing: border-box; }
                    html, body { margin: 0; background: var(--bg); color: var(--text);
                        font: 16px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
                        -webkit-text-size-adjust: 100%; }
                    .wrap { max-width: 560px; margin: 0 auto; padding: 16px 16px 40px; }
                    header.top { display: flex; align-items: center; gap: 12px; margin: 4px 0 16px; }
                    header.top img { width: 40px; height: 40px; object-fit: contain; border-radius: 8px; background: #fff; }
                    header.top .org { font-weight: 600; line-height: 1.2; }
                    header.top .sub { color: var(--muted); font-size: 13px; }
                    .card { background: var(--card); border: 1px solid var(--line); border-radius: 14px;
                        padding: 16px; margin-bottom: 12px; }
                    .amount { font-size: 30px; font-weight: 700; letter-spacing: -0.5px; margin: 2px 0 4px; }
                    .label { color: var(--muted); font-size: 13px; }
                    .badge { display: inline-block; font-size: 12px; font-weight: 600; padding: 2px 10px;
                        border-radius: 999px; background: var(--warn-bg); color: var(--warn); }
                    dl { margin: 12px 0 0; display: grid; grid-template-columns: max-content 1fr; gap: 6px 14px; }
                    dt { color: var(--muted); font-size: 14px; }
                    dd { margin: 0; font-size: 14px; word-break: break-word; }
                    h2 { font-size: 15px; margin: 0 0 10px; }
                    .line { display: flex; justify-content: space-between; gap: 12px; padding: 8px 0;
                        border-top: 1px solid var(--line); font-size: 14px; }
                    .line:first-of-type { border-top: 0; }
                    .line .d { color: var(--muted); font-size: 12px; }
                    .line .a { white-space: nowrap; font-variant-numeric: tabular-nums; }
                    .total { font-weight: 700; border-top: 2px solid var(--line); }
                    .vote { padding: 8px 0; border-top: 1px solid var(--line); font-size: 14px; }
                    .vote:first-of-type { border-top: 0; }
                    .vote .ok { color: var(--ok); font-weight: 600; }
                    .vote .bad { color: var(--bad); font-weight: 600; }
                    .note { white-space: pre-wrap; font-size: 14px; }
                    label.f { display: block; font-weight: 600; font-size: 14px; margin: 0 0 6px; }
                    textarea, input.pin { width: 100%; font: inherit; color: var(--text); background: var(--bg);
                        border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; }
                    textarea { min-height: 84px; resize: vertical; }
                    input.pin { font-size: 24px; letter-spacing: 10px; text-align: center; }
                    textarea:focus, input.pin:focus { outline: 2px solid var(--brand); outline-offset: 1px; }
                    .field { margin-bottom: 14px; }
                    .hint { color: var(--muted); font-size: 12px; margin-top: 4px; }
                    .actions { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
                    button { font: inherit; font-weight: 700; border: 0; border-radius: 12px; padding: 14px;
                        cursor: pointer; min-height: 52px; }
                    button.approve { background: var(--ok); color: #fff; }
                    button.reject { background: var(--bad-bg); color: var(--bad); border: 1px solid var(--bad); }
                    button:disabled { opacity: .6; }
                    .alert { border-radius: 12px; padding: 12px 14px; margin-bottom: 12px; font-size: 14px;
                        background: var(--bad-bg); color: var(--bad); border: 1px solid var(--bad); }
                    .result { text-align: center; padding: 32px 16px; }
                    .result .icon { font-size: 52px; line-height: 1; margin-bottom: 8px; }
                    .result.ok .icon { color: var(--ok); }
                    .result.bad .icon { color: var(--bad); }
                    footer { color: var(--muted); font-size: 12px; text-align: center; margin-top: 18px; }
                </style>
            </head>
            <body>
                <div class="wrap">
                    <header class="top" t-if="company">
                        <img t-att-src="'/web/binary/company_logo?company=%s' % company.id" alt=""/>
                        <div>
                            <div class="org" t-out="company.name"/>
                            <div class="sub">Persetujuan pengeluaran</div>
                        </div>
                    </header>
                    <t t-out="0"/>
                    <footer>Link ini pribadi. Jangan diteruskan ke orang lain.</footer>
                </div>
            </body>
        </html>
    </template>

    <template id="mobile_approval_page" name="DKM Approval: request page">
        <t t-call="dkm_approval_whatsapp.mobile_layout">
            <t t-set="page_title" t-value="'Persetujuan %s' % approval.name"/>

            <div class="card">
                <div class="label">
                    <t t-out="approval.name"/>
                    <t t-if="step_label"> · <t t-out="step_label"/></t>
                </div>
                <div class="amount" t-out="amount"/>
                <span class="badge">Menunggu persetujuan Anda</span>
                <dl>
                    <t t-if="partner_name">
                        <dt>Kepada</dt><dd t-out="partner_name"/>
                    </t>
                    <dt>Dokumen</dt><dd t-out="doc_name"/>
                    <dt>Tanggal</dt><dd t-out="doc_date"/>
                    <t t-if="ref">
                        <dt>Referensi</dt><dd t-out="ref"/>
                    </t>
                    <dt>Diajukan oleh</dt><dd t-out="requester"/>
                    <dt>Link berlaku</dt><dd>s/d <t t-out="expires"/></dd>
                </dl>
            </div>

            <div class="card" t-if="note or description">
                <h2>Keterangan</h2>
                <div class="note" t-if="note" t-out="note"/>
                <div class="note" t-if="description" t-out="description"/>
            </div>

            <div class="card" t-if="lines">
                <h2>Rincian</h2>
                <div class="line" t-foreach="lines" t-as="line">
                    <div>
                        <div t-out="line['label']"/>
                        <div class="d" t-if="line['detail']" t-out="line['detail']"/>
                    </div>
                    <div class="a" t-out="line['amount']"/>
                </div>
                <div class="line d" t-if="more_lines">
                    <div>+ <t t-out="more_lines"/> baris lainnya (lihat di Odoo)</div>
                </div>
                <div class="line total">
                    <div>Total</div>
                    <div class="a" t-out="total"/>
                </div>
            </div>

            <div class="card" t-if="votes">
                <h2>Riwayat persetujuan</h2>
                <div class="vote" t-foreach="votes" t-as="vote">
                    <span t-att-class="'ok' if vote['decision'] == 'approve' else 'bad'"
                          t-out="vote['decision_label']"/>
                    oleh <strong t-out="vote['name']"/>
                    <span class="label"> · tahap <t t-out="vote['step']"/> · <t t-out="vote['when']"/></span>
                    <div class="note label" t-if="vote['comment']" t-out="vote['comment']"/>
                </div>
            </div>

            <div class="alert" role="alert" t-if="error" t-out="error"/>

            <form class="card" method="post" id="decision-form"
                  t-att-action="'/dkm/approval/%s/decide' % token_raw"
                  t-att-data-amount="amount" autocomplete="off">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <h2>Keputusan Anda, <t t-out="approver.name"/></h2>
                <div class="field">
                    <label class="f" for="comment">Catatan</label>
                    <textarea id="comment" name="comment" maxlength="2000"
                              placeholder="Wajib diisi jika menolak. Opsional jika menyetujui."
                              t-out="comment"/>
                </div>
                <div class="field">
                    <label class="f" for="pin">PIN persetujuan</label>
                    <input class="pin" id="pin" name="pin" type="password" required="required"
                           inputmode="numeric" pattern="[0-9]{6}" maxlength="6"
                           autocomplete="off" placeholder="••••••"/>
                    <div class="hint">6 digit PIN pribadi yang Anda atur di Odoo.</div>
                </div>
                <div class="actions">
                    <button type="submit" class="reject" name="decision" value="reject">Tolak</button>
                    <button type="submit" class="approve" name="decision" value="approve">Setujui</button>
                </div>
            </form>

            <script>
                (function () {
                    var form = document.getElementById('decision-form');
                    var amount = form.dataset.amount;
                    form.addEventListener('submit', function (ev) {
                        var btn = ev.submitter;
                        var decision = btn &amp;&amp; btn.value;
                        var comment = form.comment.value.trim();
                        if (decision === 'reject' &amp;&amp; !comment) {
                            ev.preventDefault();
                            alert('Tuliskan alasan penolakan di kolom Catatan.');
                            form.comment.focus();
                            return;
                        }
                        var question = decision === 'reject'
                            ? 'Tolak pengajuan sebesar ' + amount + '?'
                            : 'Setujui pengeluaran sebesar ' + amount + '?';
                        if (!confirm(question)) { ev.preventDefault(); return; }
                        var hidden = document.createElement('input');
                        hidden.type = 'hidden'; hidden.name = 'decision'; hidden.value = decision;
                        form.appendChild(hidden);
                        Array.prototype.forEach.call(form.querySelectorAll('button'), function (b) {
                            b.disabled = true;
                        });
                        btn.textContent = 'Memproses…';
                    });
                })();
            </script>
        </t>
    </template>

    <template id="mobile_message" name="DKM Approval: result message">
        <t t-call="dkm_approval_whatsapp.mobile_layout">
            <t t-set="company" t-value="approval and approval.company_id"/>
            <div t-att-class="'card result ' + ('ok' if ok else 'bad')">
                <div class="icon" t-out="'✓' if ok and decision != 'reject' else ('✕' if ok else '!')"/>
                <h2 t-out="title"/>
                <p t-out="message"/>
                <p class="label" t-if="approval">
                    <t t-out="approval.name"/> — status:
                    <t t-out="state_label"/>
                </p>
                <p class="label">Anda boleh menutup halaman ini.</p>
            </div>
        </t>
    </template>

</odoo>
