<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_activity" model="ir.ui.view">
        <field name="name">account.move.form.activity.dkm.kegiatan</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_left_group']" position="inside">
                <field name="dkm_activity_id"
                       invisible="move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund')"
                       readonly="state != 'draft'"
                       options="{'no_create': True, 'no_open': True}"
                       placeholder="Kosongkan jika bukan untuk kegiatan"/>
            </xpath>
            <xpath expr="//page[@id='invoice_tab']//column[@name='product_and_description']" position="after">
                <field name="dkm_activity_id" column_invisible="True"/>
                <field name="dkm_activity_budget_id" optional="show"
                       column_invisible="not parent.dkm_activity_id"
                       options="{'no_create': True, 'no_open': True}"/>
            </xpath>
            <!-- Journal entries: activity and pos per line. -->
            <xpath expr="//field[@name='line_ids']/list/field[@name='account_id'][1]" position="after">
                <field name="dkm_activity_id" optional="hide"
                       column_invisible="parent.move_type != 'entry'"
                       options="{'no_create': True, 'no_open': True}"/>
                <field name="dkm_activity_budget_id" optional="hide"
                       column_invisible="parent.move_type != 'entry'"
                       options="{'no_create': True, 'no_open': True}"/>
            </xpath>
        </field>
    </record>

    <record id="view_invoice_tree_activity" model="ir.ui.view">
        <field name="name">account.invoice.list.activity.dkm.kegiatan</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date'][contains(@column_invisible, 'out_invoice')]" position="before">
                <field name="dkm_activity_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_invoice_filter_activity" model="ir.ui.view">
        <field name="name">account.invoice.select.activity.dkm.kegiatan</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="dkm_activity_id"/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter name="group_by_activity" string="Kegiatan" context="{'group_by': 'dkm_activity_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
