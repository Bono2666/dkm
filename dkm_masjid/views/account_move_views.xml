<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Customer invoices record mosque receipts: donor instead of customer,
         receipt category instead of product, no due date or delivery. -->
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form.dkm.masjid</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_left_group']/label[@for='partner_id'][1]" position="attributes">
                <attribute name="string">Donatur</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id'][@widget='res_partner_many2one']" position="attributes">
                <attribute name="placeholder">Cari nama...</attribute>
            </xpath>
            <xpath expr="//group[@id='header_right_group']/label[@for='invoice_date'][1]" position="attributes">
                <attribute name="string">Tanggal Penerimaan</attribute>
            </xpath>
            <xpath expr="//div[label[@for='invoice_date_due']]" position="attributes">
                <attribute name="invisible">move_type not in ('in_invoice', 'in_refund', 'in_receipt')</attribute>
            </xpath>
            <xpath expr="//div[@name='due_date']" position="attributes">
                <attribute name="invisible">move_type not in ('in_invoice', 'in_refund', 'in_receipt')</attribute>
            </xpath>
            <!-- Bill header: vendor, bill reference, bill date, due date.
                 The accounting date follows the bill date; it shows again
                 only if a posted bill was booked on another date. -->
            <xpath expr="//field[@name='invoice_vendor_bill_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group[@id='header_right_group']/field[@name='date']" position="attributes">
                <attribute name="invisible">move_type in ('out_invoice', 'out_refund', 'out_receipt', 'in_invoice', 'in_refund') and not quick_edit_mode and not (state == 'posted' and date != invoice_date)</attribute>
            </xpath>
            <xpath expr="//group[@id='header_right_group']/field[@name='payment_reference']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group[@id='header_right_group']/field[@name='partner_bank_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[@name='due_date']/span" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[@name='due_date']/field[@name='invoice_payment_term_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- Bills have nothing left in Other Info (fiscal position,
                 payment method, auto-post are hidden below). -->
            <xpath expr="//page[@id='other_tab']" position="attributes">
                <attribute name="invisible">move_type in ('entry', 'in_invoice', 'in_refund')</attribute>
            </xpath>
            <xpath expr="//page[@id='invoice_tab']" position="attributes">
                <attribute name="string">Rincian</attribute>
            </xpath>
            <xpath expr="//page[@id='invoice_tab']//column[@name='product_and_description']" position="attributes">
                <attribute name="string">Keterangan</attribute>
            </xpath>
            <xpath expr="//page[@id='invoice_tab']//column[@name='product_and_description']/field[@name='product_id']" position="attributes">
                <attribute name="string">Kategori</attribute>
                <attribute name="placeholder">Pilih kategori</attribute>
            </xpath>
            <xpath expr="//group[@name='sale_info_group']" position="attributes">
                <attribute name="string">Penerimaan</attribute>
            </xpath>
            <xpath expr="//group[@name='sale_info_group']/label[@for='ref']" position="attributes">
                <attribute name="string">Referensi</attribute>
            </xpath>
            <xpath expr="//group[@name='sale_info_group']/field[@name='invoice_user_id']" position="attributes">
                <attribute name="string">Petugas</attribute>
            </xpath>
            <xpath expr="//group[@name='sale_info_group']/field[@name='delivery_date']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Title: the selector would print "Faktur Pelanggan" or offer
                 "Bon / Penerimaan" (a purchase receipt, not a mosque one). -->
            <xpath expr="//div[hasclass('oe_title')]//field[@name='move_type']" position="attributes">
                <attribute name="invisible">move_type in ('entry', 'out_invoice', 'out_refund', 'in_invoice', 'in_refund') or is_self_billing</attribute>
            </xpath>
            <xpath expr="//div[hasclass('oe_title')]/span[field[@name='move_type']]" position="after">
                <span class="o_form_label" invisible="move_type != 'out_invoice'">Nota Penerimaan</span>
                <span class="o_form_label" invisible="move_type != 'out_refund'">Pengembalian Dana</span>
                <span class="o_form_label" invisible="move_type != 'in_invoice'">Tagihan Vendor</span>
                <span class="o_form_label" invisible="move_type != 'in_refund'">Pengembalian dari Vendor</span>
            </xpath>

            <!-- A receipt line is a category and an amount: no quantity or
                 unit price. Bills keep quantity x unit price (shopping lists).
                 Neither has discounts or taxes: mosques are not PKP. -->
            <xpath expr="//field[@id='document_tax_mode']" position="attributes">
                <attribute name="invisible">move_type in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund')</attribute>
            </xpath>
            <xpath expr="//field[@id='document_tax_mode_mobile']" position="attributes">
                <attribute name="invisible">move_type in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund')</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/control/button[@name='action_add_from_catalog']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='quantity']" position="attributes">
                <attribute name="column_invisible">parent.move_type in ('out_invoice', 'out_refund')</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_uom_id'][@optional='show']" position="attributes">
                <attribute name="column_invisible">parent.move_type in ('out_invoice', 'out_refund')</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_unit']" position="attributes">
                <attribute name="string">Harga Satuan</attribute>
                <attribute name="column_invisible">parent.move_type in ('out_invoice', 'out_refund')</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_unit']" position="after">
                <field name="price_unit" string="Nominal"
                       column_invisible="parent.move_type not in ('out_invoice', 'out_refund')"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='discount']" position="attributes">
                <attribute name="column_invisible">parent.move_type in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund')</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='tax_ids']" position="attributes">
                <attribute name="column_invisible">parent.move_type in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund')</attribute>
            </xpath>
            <!-- Fixed-asset purchases still work: the column can be shown. -->
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='asset_category_id']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_subtotal']" position="attributes">
                <attribute name="column_invisible">parent.document_tax_mode == 'tax_included' or parent.move_type in ('out_invoice', 'out_refund')</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_total']" position="attributes">
                <attribute name="column_invisible">parent.document_tax_mode == 'tax_excluded' or parent.move_type in ('out_invoice', 'out_refund')</attribute>
            </xpath>

            <!-- Totals: static/src/tax_totals shows one "Total Penerimaan" /
                 "Total Tagihan" line (amount_total itself is not recomputed
                 in the form before saving). -->
            <xpath expr="//field[@name='narration']" position="attributes">
                <attribute name="placeholder">Catatan</attribute>
            </xpath>
            <!-- A receipt records money already received: no amount due.
                 Bills show what is left to pay, without overlapping. -->
            <xpath expr="//div[label[@for='amount_residual']]" position="attributes">
                <attribute name="invisible">move_type in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund')</attribute>
            </xpath>
            <xpath expr="//div[label[@for='amount_residual']]" position="after">
                <div class="d-flex justify-content-end align-items-baseline gap-3 text-nowrap" colspan="2"
                     name="dkm_bill_residual" invisible="move_type not in ('in_invoice', 'in_refund')">
                    <span class="flex-shrink-0">Belum Dibayar</span>
                    <field name="amount_residual" class="fw-bold flex-shrink-0"/>
                </div>
            </xpath>

            <!-- Journal Items tab: no tax grids or early-payment discounts
                 (mosques are not PKP); no taxes or due dates on receipts. -->
            <!-- Newer Odoo 20 builds show "label" there and hide "name". -->
            <xpath expr="//field[@name='line_ids']/list/field[@name='label'] | //field[@name='line_ids']/list/field[@name='name'][not(../field[@name='label'])]" position="attributes">
                <attribute name="string">Keterangan</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='tax_tag_ids']" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='discount_date']" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='discount_amount_currency']" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='tax_ids']" position="attributes">
                <attribute name="column_invisible">parent.move_type in ('out_invoice', 'out_refund')</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='date_maturity']" position="attributes">
                <attribute name="column_invisible">context.get('view_no_maturity') or parent.move_type in ('out_invoice', 'out_refund')</attribute>
            </xpath>

            <!-- Other Info tab of a receipt: only reference and officer. -->
            <xpath expr="//group[@name='sale_info_group']/field[@name='team_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group[@name='sale_info_group']/field[@name='partner_bank_id'][1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group[@name='sale_info_group']/field[@name='partner_bank_id'][2]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group[@name='sale_info_group']/field[@name='payment_reference']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group[@name='sale_info_group']/field[@name='qr_code_method']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group[@name='accounting_info_group']" position="attributes">
                <attribute name="invisible">move_type in ('out_invoice', 'out_refund')</attribute>
            </xpath>
            <xpath expr="//group[field[@name='l10n_id_coretax_document']]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_incoterm_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='incoterm_location']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_invoice_tree" model="ir.ui.view">
        <field name="name">account.invoice.list.dkm.masjid</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id'][contains(@column_invisible, 'out_invoice')]" position="attributes">
                <attribute name="string">Donatur</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_date'][contains(@column_invisible, 'out_invoice')]" position="attributes">
                <attribute name="string">Tanggal Penerimaan</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_user_id'][contains(@column_invisible, 'out_invoice')]" position="attributes">
                <attribute name="string">Petugas</attribute>
            </xpath>
            <!-- No taxes anywhere; receipts are paid on the spot, so no due
                 date or amount due on the receipt lists. -->
            <xpath expr="//field[@name='amount_untaxed_in_currency_signed']" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>
            <xpath expr="//field[@name='amount_tax_signed']" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_date_due']" position="attributes">
                <attribute name="column_invisible">context.get('default_move_type') in ('out_invoice', 'out_refund', 'out_receipt')</attribute>
            </xpath>
            <xpath expr="//field[@name='amount_residual_signed']" position="attributes">
                <attribute name="string">Belum Dibayar</attribute>
                <attribute name="sum">Belum Dibayar</attribute>
                <attribute name="column_invisible">context.get('default_move_type') in ('out_invoice', 'out_refund', 'out_receipt')</attribute>
            </xpath>
        </field>
    </record>

    <!-- Search filters: no "Faktur", "Nota Kredit" or purchase receipts. -->
    <record id="view_account_invoice_filter" model="ir.ui.view">
        <field name="name">account.invoice.select.dkm.masjid</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <filter name="out_invoice" position="attributes">
                <attribute name="string">Nota Penerimaan</attribute>
            </filter>
            <filter name="out_receipt" position="attributes">
                <attribute name="invisible">1</attribute>
            </filter>
            <filter name="out_refund" position="attributes">
                <attribute name="string">Pengembalian Dana</attribute>
            </filter>
            <filter name="salesperson" position="attributes">
                <attribute name="string">Petugas</attribute>
            </filter>
        </field>
    </record>

    <record id="view_account_bill_filter" model="ir.ui.view">
        <field name="name">account.bill.select.dkm.masjid</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_bill_filter"/>
        <field name="arch" type="xml">
            <filter name="in_invoice" position="attributes">
                <attribute name="string">Tagihan Vendor</attribute>
            </filter>
            <filter name="in_receipt" position="attributes">
                <attribute name="invisible">1</attribute>
            </filter>
            <filter name="in_refund" position="attributes">
                <attribute name="string">Pengembalian dari Vendor</attribute>
            </filter>
        </field>
    </record>

    <!-- ERP Heritage journal entry PDF: title of an unnumbered entry. -->
    <template id="eh_report_account_move" inherit_id="eh_account_base.report_eh_account_move">
        <xpath expr="//h1[hasclass('eh_pdf_title')]/t" position="attributes">
            <attribute name="t-out">move.name or 'Draf'</attribute>
        </xpath>
    </template>
</odoo>
