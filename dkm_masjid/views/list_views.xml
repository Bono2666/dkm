<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Payment lists: donors and vendors, one currency. -->
    <record id="view_account_payment_tree" model="ir.ui.view">
        <field name="name">account.payment.list.dkm.masjid</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="attributes">
                <attribute name="string">Donatur</attribute>
            </field>
            <xpath expr="//field[@name='amount_signed'][@optional='show']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_account_payment_search" model="ir.ui.view">
        <field name="name">account.payment.search.dkm.masjid</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search"/>
        <field name="arch" type="xml">
            <filter name="inbound_filter" position="attributes">
                <attribute name="string">Dana Masuk</attribute>
            </filter>
            <filter name="outbound_filter" position="attributes">
                <attribute name="string">Pembayaran Keluar</attribute>
            </filter>
            <field name="partner_id" position="attributes">
                <attribute name="string">Donatur/Vendor</attribute>
            </field>
        </field>
    </record>

    <!-- Donor and vendor lists. -->
    <record id="res_partner_view_search" model="ir.ui.view">
        <field name="name">res.partner.search.dkm.masjid</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.res_partner_view_search"/>
        <field name="arch" type="xml">
            <filter name="customer" position="attributes">
                <attribute name="string">Donatur</attribute>
            </filter>
            <filter name="supplier" position="attributes">
                <attribute name="string">Vendor</attribute>
            </filter>
        </field>
    </record>

    <!-- Akuntansi > Entri Jurnal -->
    <record id="view_move_tree" model="ir.ui.view">
        <field name="name">account.move.list.dkm.masjid</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="attributes">
                <attribute name="string">Donatur/Vendor</attribute>
            </field>
        </field>
    </record>

    <!-- Akuntansi > Aset > Aset Tetap: one currency. -->
    <record id="account_asset_asset_view_tree" model="ir.ui.view">
        <field name="name">account.asset.asset.list.dkm.masjid</field>
        <field name="model">account.asset.asset</field>
        <field name="inherit_id" ref="base_accounting_kit.account_asset_asset_view_tree"/>
        <field name="arch" type="xml">
            <list position="attributes">
                <attribute name="string">Aset Tetap</attribute>
            </list>
            <field name="currency_id" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>
        </field>
    </record>

    <!-- Tinjauan > Item Jurnal -->
    <record id="view_move_line_tree" model="ir.ui.view">
        <field name="name">account.move.line.list.dkm.masjid</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="string">Donatur/Vendor</attribute>
            </xpath>
            <!-- Newer Odoo 20 builds show "label" there and hide "name". -->
            <xpath expr="//field[@name='label'] | //field[@name='name'][not(../field[@name='label'])]" position="attributes">
                <attribute name="string">Keterangan</attribute>
            </xpath>
        </field>
    </record>

    <!-- Laporan > Analisis Penerimaan & Tagihan -->
    <record id="view_account_invoice_report_search" model="ir.ui.view">
        <field name="name">account.invoice.report.search.dkm.masjid</field>
        <field name="model">account.invoice.report</field>
        <field name="inherit_id" ref="account.view_account_invoice_report_search"/>
        <field name="arch" type="xml">
            <filter name="my_invoice" position="attributes">
                <attribute name="string">Catatan Saya</attribute>
            </filter>
            <filter name="toinvoice" position="attributes">
                <attribute name="string">Draf</attribute>
            </filter>
            <filter name="current" position="attributes">
                <attribute name="string">Terekam</attribute>
            </filter>
            <filter name="customer" position="attributes">
                <attribute name="string">Donatur</attribute>
            </filter>
            <filter name="invoice" position="attributes">
                <attribute name="string">Nota Penerimaan &amp; Tagihan</attribute>
            </filter>
            <filter name="creditnote" position="attributes">
                <attribute name="string">Pengembalian</attribute>
            </filter>
            <filter name="user" position="attributes">
                <attribute name="string">Petugas</attribute>
            </filter>
            <filter name="sales_channel" position="attributes">
                <attribute name="invisible">1</attribute>
            </filter>
            <filter name="partner_id" position="attributes">
                <attribute name="string">Donatur/Vendor</attribute>
            </filter>
            <filter name="category_product" position="attributes">
                <attribute name="string">Kategori</attribute>
                <attribute name="context">{'group_by': 'product_id'}</attribute>
            </filter>
        </field>
    </record>

    <!-- Group by receipt category (Infaq, Zakat, ...), not product category. -->
    <record id="view_account_invoice_report_graph" model="ir.ui.view">
        <field name="name">account.invoice.report.graph.dkm.masjid</field>
        <field name="model">account.invoice.report</field>
        <field name="inherit_id" ref="account.view_account_invoice_report_graph"/>
        <field name="arch" type="xml">
            <graph position="attributes">
                <attribute name="string">Analisis Penerimaan &amp; Tagihan</attribute>
            </graph>
            <field name="product_categ_id" position="replace">
                <field name="product_id"/>
            </field>
        </field>
    </record>

    <!-- Laporan > Analisis Aset -->
    <record id="asset_asset_report_view_search" model="ir.ui.view">
        <field name="name">asset.asset.report.search.dkm.masjid</field>
        <field name="model">asset.asset.report</field>
        <field name="inherit_id" ref="base_accounting_kit.asset_asset_report_view_search"/>
        <field name="arch" type="xml">
            <filter name="only_active" position="attributes">
                <attribute name="string">Aktif</attribute>
            </filter>
        </field>
    </record>
</odoo>
