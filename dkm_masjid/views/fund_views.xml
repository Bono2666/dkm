<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sumber Dana (Konfigurasi) -->
    <record id="view_dkm_fund_list" model="ir.ui.view">
        <field name="name">dkm.fund.list</field>
        <field name="model">dkm.fund</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="note"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_dkm_fund" model="ir.actions.act_window">
        <field name="name">Sumber Dana</field>
        <field name="res_model">dkm.fund</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_dkm_fund" name="Sumber Dana"
              parent="account.account_account_menu"
              action="action_dkm_fund" sequence="91"
              groups="account.group_account_manager"/>

    <!-- Bills: which fund pays. -->
    <record id="view_move_form_fund" model="ir.ui.view">
        <field name="name">account.move.form.fund.dkm.masjid</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_left_group']" position="inside">
                <field name="dkm_fund_id"
                       invisible="move_type not in ('in_invoice', 'in_refund')"
                       required="move_type in ('in_invoice', 'in_refund') and state == 'draft'"
                       readonly="state != 'draft'"
                       options="{'no_create': True, 'no_open': True}"/>
            </xpath>
            <!-- Receipts: the category sets the fund; it can be changed per line. -->
            <xpath expr="//page[@id='invoice_tab']//column[@name='product_and_description']" position="after">
                <field name="dkm_fund_id" optional="show"
                       column_invisible="parent.move_type not in ('out_invoice', 'out_refund')"
                       options="{'no_create': True, 'no_open': True}"/>
            </xpath>
            <!-- Journal entries (e.g. opening fund balances on Aset Neto). -->
            <xpath expr="//field[@name='line_ids']/list/field[@name='account_id'][1]" position="after">
                <field name="dkm_fund_id" optional="show"
                       column_invisible="parent.move_type != 'entry'"
                       options="{'no_create': True, 'no_open': True}"/>
            </xpath>
        </field>
    </record>

    <record id="view_invoice_tree_fund" model="ir.ui.view">
        <field name="name">account.invoice.list.fund.dkm.masjid</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date'][contains(@column_invisible, 'out_invoice')]" position="before">
                <field name="dkm_fund_id" optional="show"
                       column_invisible="context.get('default_move_type') not in ('in_invoice', 'in_refund', 'in_receipt')"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_bill_filter_fund" model="ir.ui.view">
        <field name="name">account.bill.select.fund.dkm.masjid</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_bill_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="dkm_fund_id"/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter name="group_by_fund" string="Sumber Dana" context="{'group_by': 'dkm_fund_id'}"/>
            </xpath>
        </field>
    </record>

    <!-- Receipt categories: their fund. -->
    <record id="product_template_form_fund" model="ir.ui.view">
        <field name="name">product.template.form.fund.dkm.masjid</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="account.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="property_account_income_id" position="after">
                <field name="dkm_fund_id" invisible="not sale_ok"
                       options="{'no_create': True}"/>
            </field>
        </field>
    </record>

    <!-- Laporan > Saldo Dana -->
    <record id="view_dkm_fund_report_list" model="ir.ui.view">
        <field name="name">dkm.fund.report.list</field>
        <field name="model">dkm.fund.report</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="fund_id"/>
                <field name="move_id"/>
                <field name="partner_id" optional="show"/>
                <field name="name" optional="show"/>
                <field name="account_id" optional="hide"/>
                <field name="opening" sum="Total" optional="show"/>
                <field name="income" sum="Total"/>
                <field name="expense" sum="Total"/>
                <field name="balance" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_dkm_fund_report_pivot" model="ir.ui.view">
        <field name="name">dkm.fund.report.pivot</field>
        <field name="model">dkm.fund.report</field>
        <field name="arch" type="xml">
            <pivot disable_linking="0">
                <field name="fund_id" type="row"/>
                <field name="opening" type="measure"/>
                <field name="income" type="measure"/>
                <field name="expense" type="measure"/>
                <field name="balance" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_dkm_fund_report_search" model="ir.ui.view">
        <field name="name">dkm.fund.report.search</field>
        <field name="model">dkm.fund.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="fund_id"/>
                <field name="partner_id"/>
                <field name="account_id"/>
                <filter name="date" string="Tanggal" date="date"/>
                <separator/>
                <filter name="income" string="Penerimaan" domain="[('income', '!=', 0)]"/>
                <filter name="expense" string="Pengeluaran" domain="[('expense', '!=', 0)]"/>
                <group>
                    <filter name="group_fund" string="Sumber Dana" context="{'group_by': 'fund_id'}"/>
                    <filter name="group_account" string="Akun" context="{'group_by': 'account_id'}"/>
                    <filter name="group_month" string="Bulan" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dkm_fund_report" model="ir.actions.act_window">
        <field name="name">Saldo Dana</field>
        <field name="res_model">dkm.fund.report</field>
        <field name="view_mode">pivot,list</field>
        <field name="context">{'search_default_group_fund': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Belum ada transaksi</p>
            <p>Saldo setiap sumber dana: saldo awal, penerimaan (menurut kategori
               Nota Penerimaan) dikurangi pengeluaran (menurut Sumber Dana pada
               tagihan dan penggajian).</p>
        </field>
    </record>

    <menuitem id="menu_dkm_fund_report" name="Saldo Dana"
              parent="account.menu_finance_reports"
              action="action_dkm_fund_report" sequence="0"/>
</odoo>
